#!/bin/sh
# Wazuh invoca este wrapper (nombre sin extension); usa su Python embebido.
DIR=$(dirname "$0")
PY_SCRIPT="${DIR}/custom-telegram.py"
WAZUH_PYTHON="/var/ossec/framework/python/bin/python3"

if [ -x "${WAZUH_PYTHON}" ]; then
    "${WAZUH_PYTHON}" "${PY_SCRIPT}" "$@"
else
    python3 "${PY_SCRIPT}" "$@"
fi
