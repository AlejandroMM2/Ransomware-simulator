#!/bin/sh
# custom-telegram — envoltorio que Wazuh invoca (nombre sin extension).
# Llama al script Python con el interprete embebido de Wazuh si existe,
# y si no, con el python3 del sistema. Reenvia los argumentos tal cual.

DIR=$(dirname "$0")
PY_SCRIPT="${DIR}/custom-telegram.py"
WAZUH_PYTHON="/var/ossec/framework/python/bin/python3"

if [ -x "${WAZUH_PYTHON}" ]; then
    "${WAZUH_PYTHON}" "${PY_SCRIPT}" "$@"
else
    python3 "${PY_SCRIPT}" "$@"
fi
